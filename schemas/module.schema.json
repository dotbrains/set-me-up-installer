{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up module manifest",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/-]*$" },
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "platforms": {
            "type": "array",
            "items": { "type": "string", "enum": ["macos", "debian", "ubuntu", "arch", "linux", "nixos"] }
          },
          "requires_root": { "type": "boolean" },
          "secrets": { "type": "boolean" },
          "services": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reboot_required": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "adapters"],
  "additionalProperties": false
}
