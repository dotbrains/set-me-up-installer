{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up prompt profile",
  "type": "object",
  "required": ["schema_version", "id", "name", "description", "engine", "theme_aware", "adapters"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "extends": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "engine": { "enum": ["starship", "shell"] },
    "theme_aware": { "type": "boolean" },
    "adapters": {
      "type": "object",
      "required": ["bash", "zsh", "fish", "nushell"]
    }
  }
}
