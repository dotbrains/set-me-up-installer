{
  "$id": "https://dotbrains.dev/set-me-up/contracts/secrets-doctor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "set-me-up secrets doctor contract",
  "type": "object",
  "required": ["root", "findings", "ok"],
  "properties": {
    "root": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "risk"]
      }
    },
    "ok": { "type": "boolean" }
  }
}
